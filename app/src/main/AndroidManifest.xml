<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".PocketBibleApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.PocketBible"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PocketBible">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Lets AppCompatDelegate.setApplicationLocales() persist the in-app
          language choice across process restarts (cold app launch), on top
          of MainActivity extending AppCompatActivity, which is what makes
          recreate() actually reload resources in the new locale right away.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
